# Copy this file to .env and fill in your values.
PORT=5000

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string.
# Replace <password> and add the database name (jaggery) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jaggery?retryWrites=true&w=majority

# Long random text used to sign admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin panel login (created by "npm run seed")
ADMIN_EMAIL=admin@selco-foundation.org
ADMIN_PASSWORD=change-this-password

# Where uploaded photos/videos are stored (relative to the server folder)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
